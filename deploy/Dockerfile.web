FROM nginx:1.27-alpine AS static-assets

COPY index.html /site/index.html
COPY admin /site/admin
COPY account /site/account
COPY css /site/css
COPY js /site/js
COPY assets /site/assets
COPY tb /site/tb
# Only browser assets enter the final image, including its layers.
RUN find /site -type f ! \( -iname '*.html' -o -iname '*.css' -o -iname '*.js' \
    -o -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \
    -o -iname '*.svg' -o -iname '*.ico' -o -iname '*.woff' -o -iname '*.woff2' \
    -o -iname '*.ttf' -o -iname '*.otf' \) -delete \
    && chmod -R a+rX /site

FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=static-assets /site/ /usr/share/nginx/html/

# Source files copied from an NAS share can retain restrictive ownership or
# mode bits. Nginx workers must be able to read every published asset.
RUN chmod -R a+rX /usr/share/nginx/html

EXPOSE 80
