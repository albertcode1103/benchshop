# NAS persistent-data directory. This relative path becomes data/ below the
# Compose project. It is excluded from Git and Docker build context; back it up
# to another NAS shared folder. An absolute NAS path is also supported.
BOTEN_DATA_DIR=./data

# Use the final public origin, without a trailing slash.  The web and API
# containers share one origin, so this is intentionally the only allowed CORS origin.
BOTEN_CORS_ORIGINS=https://benchshop.example.com

# Override only if the NAS image uses a custom Chinese font.
BOTEN_PDF_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
